{
  "name": "@indiafoss/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "prebuild": "node scripts/sync-event-bundle.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@indiafoss/model": "workspace:*",
    "@indiafoss/schedule": "workspace:*",
    "@indiafoss/search": "workspace:*",
    "@indiafoss/storage": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^24.0.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
