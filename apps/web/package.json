{
  "name": "@indiafoss/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "prebuild": "node scripts/sync-assets.mjs",
    "build": "vite build",
    "preview": "sirv build --single",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "test:e2e": "playwright test tests/app.spec.ts",
    "postbuild": "node scripts/patch-sw.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.5.1",
    "@capacitor/local-notifications": "^8.3.1",
    "@indiafoss/elo": "workspace:*",
    "@indiafoss/matrix": "workspace:*",
    "@indiafoss/model": "workspace:*",
    "@indiafoss/schedule": "workspace:*",
    "@indiafoss/search": "workspace:*",
    "@indiafoss/solver": "workspace:*",
    "@indiafoss/storage": "workspace:*",
    "@indiafoss/venue": "workspace:*",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@vite-pwa/sveltekit": "^1.1.0",
    "sirv-cli": "^3.0.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
