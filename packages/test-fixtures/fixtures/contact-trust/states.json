{
  "describes": "Trust states a contact screen must keep apart (#31, #188). Each case is a stored contact record (the fields that matter) and the separate conclusions every platform must draw from it. No case may produce `verified` for the account or the chat line: nothing in either app holds cross-signing evidence.",
  "vocabulary": {
    "signature": ["valid", "invalid", "unsigned", "key-changed"],
    "account": ["claimed", "profile-matched"],
    "profile": ["no-claim", "unchecked", "profile-matched", "mismatch", "unlinked", "outdated"],
    "inPerson": ["confirmed", "confirmed-earlier-key", "unconfirmed", "no-badge"],
    "chat": ["not-verified"],
    "routes": ["mesh", "matrix"]
  },
  "cases": [
    {
      "name": "unsigned-card-from-another-app",
      "describes": "a plain vCard from a camera app: no key, no accounts, no route",
      "record": { "fullName": "Riya", "verified": false, "socials": {} },
      "expect": {
        "signature": "unsigned",
        "account": "claimed",
        "contradiction": false,
        "profile": "no-claim",
        "inPerson": "no-badge",
        "chat": "not-verified",
        "routes": []
      }
    },
    {
      "name": "signed-card-signature-valid",
      "describes": "a valid signature proves control of the card key and nothing else",
      "record": {
        "fullName": "Asha",
        "verified": false,
        "socials": {},
        "signature": "valid",
        "fingerprint": "8f2a9c1d4e6b7a3f8f2a9c1d4e6b7a3f8f2a9c1d4e6b7a3f8f2a9c1d4e6b7a3f"
      },
      "expect": {
        "signature": "valid",
        "account": "claimed",
        "contradiction": false,
        "profile": "no-claim",
        "inPerson": "unconfirmed",
        "chat": "not-verified",
        "routes": []
      }
    },
    {
      "name": "signed-card-bad-signature",
      "describes": "an altered or re-encoded card",
      "record": {
        "fullName": "Asha",
        "verified": false,
        "socials": {},
        "signature": "invalid",
        "fingerprint": "8f2a9c1d4e6b7a3f8f2a9c1d4e6b7a3f8f2a9c1d4e6b7a3f8f2a9c1d4e6b7a3f"
      },
      "expect": {
        "signature": "invalid",
        "account": "claimed",
        "contradiction": false,
        "profile": "no-claim",
        "inPerson": "unconfirmed",
        "chat": "not-verified",
        "routes": []
      }
    },
    {
      "name": "key-changed-since-earlier-card",
      "describes": "same person, different key: flagged, never silently replaced",
      "record": {
        "fullName": "Asha",
        "verified": false,
        "socials": {},
        "signature": "valid",
        "keyChanged": true,
        "fingerprint": "1111111111111111111111111111111111111111111111111111111111111111",
        "previousFingerprint": "8f2a9c1d4e6b7a3f8f2a9c1d4e6b7a3f8f2a9c1d4e6b7a3f8f2a9c1d4e6b7a3f"
      },
      "expect": {
        "signature": "key-changed",
        "account": "claimed",
        "contradiction": false,
        "profile": "no-claim",
        "inPerson": "unconfirmed",
        "chat": "not-verified",
        "routes": []
      }
    },
    {
      "name": "account-link-claimed-not-checked",
      "describes": "a card naming both ids, before any profile read: a claim, with routes that may or may not work",
      "record": {
        "fullName": "Asha",
        "verified": false,
        "socials": {},
        "signature": "valid",
        "fingerprint": "8f2a9c1d4e6b7a3f8f2a9c1d4e6b7a3f8f2a9c1d4e6b7a3f8f2a9c1d4e6b7a3f",
        "matrixId": "@asha:example.org",
