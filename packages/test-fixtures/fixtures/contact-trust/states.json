      "record": {
        "fullName": "Asha",
        "verified": false,
        "socials": {},
        "matrixId": "@asha:example.org",
        "neutrinoServerName": "845aa456078572639c1543694de69e0a03fb883bd9c1dab1a2f6df811b75897e",
        "meshLink": { "state": "unverifiable", "checkedAt": 1758000000000 }
      },
      "expect": {
