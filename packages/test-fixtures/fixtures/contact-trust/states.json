        "fingerprint": "8f2a9c1d4e6b7a3f8f2a9c1d4e6b7a3f8f2a9c1d4e6b7a3f8f2a9c1d4e6b7a3f",
        "matrixId": "@asha:example.org",
        "neutrinoServerName": "845aa456078572639c1543694de69e0a03fb883bd9c1dab1a2f6df811b75897e",
        "meshLink": { "state": "mismatch", "checkedAt": 1758000000000 }
      },
      "expect": {
