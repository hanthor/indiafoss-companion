{
  "describes": "Trust states a contact screen must keep apart (#31, #188). Each case is a stored contact record (the fields that matter) and the separate conclusions every platform must draw from it. No case may produce `verified` for the account or the chat line: nothing in either app holds cross-signing evidence. A valid signed binding (docs/identity-binding.md) reaches `binding-valid`, and stops there.",
  "vocabulary": {
    "signature": [
      "valid",
      "invalid",
      "unsigned",
      "key-changed"
    ],
    "account": [
      "claimed",
      "profile-matched",
      "binding-valid",
      "revoked"
    ],
    "profile": [
      "no-claim",
      "unchecked",
      "profile-matched",
      "mismatch",
      "unlinked",
      "outdated"
    ],
    "inPerson": [
      "confirmed",
      "confirmed-earlier-key",
      "unconfirmed",
      "no-badge"
    ],
    "chat": [
      "not-verified"
    ],
    "routes": [
      "mesh",
      "matrix"
    ],
    "binding": [
      "none",
      "valid",
      "expired",
      "revoked",
      "invalid",
      "unreadable",
      "unchecked"
    ]
  },
  "cases": [
