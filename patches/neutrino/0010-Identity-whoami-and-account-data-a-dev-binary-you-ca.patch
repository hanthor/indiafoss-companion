@@ -516,7 +516,29 @@ CREATE TABLE cross_signing_keys (
 CREATE TABLE to_device_inbox (
     inbox_id  INTEGER NOT NULL PRIMARY KEY,
     user      TEXT NOT NULL,
+    -- The device the message is for; '*' for whichever of the user's devices
+    -- syncs first.
+    device    TEXT NOT NULL,
