{
  "name": "@indiafoss/fixture-recorder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Capture upstream responses as deterministic fixtures",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit -p .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "@indiafoss/model": "workspace:*",
    "@indiafoss/sources": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^10.9.1",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
}
