{
  "name": "@indiafoss/neutrino-probe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Probe a running Neutrino homeserver for the client-server endpoints the companion's chat actually needs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit -p .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "start": "tsx src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^10.9.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@indiafoss/matrix": "workspace:*"
  }
}
