{
  "name": "@indiafoss/release-record",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Assemble and validate a capability record for a release: exact pins in, honest default claims out",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit -p .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "@indiafoss/model": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^10.9.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "^5.0.0"
  }
}
